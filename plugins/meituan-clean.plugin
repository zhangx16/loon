[Script]
http-response ^https?:\/\/apimobile\.meituan\.com\/aggroup\/indexTab script-path=https://raw.githubusercontent.com/zhangx16/loon/main/scripts/meituan/mt.js,requires-body=true,binary-body-mode=false,timeout=20,tag=美团底部标签
http-response ^https?:\/\/feedguess\.meituan\.com\/lycoris\/scene\/(gwc_feed1_2265|personalcenter_2154)(\?|$) script-path=https://raw.githubusercontent.com/zhangx16/loon/main/scripts/meituan/mt.js,requires-body=true,binary-body-mode=false,timeout=20,tag=美团推荐流
http-response ^https?:\/\/mt-personalcenter\.meituan\.com\/usercenter\/display script-path=https://raw.githubusercontent.com/zhangx16/loon/main/scripts/meituan/mt.js,requires-body=true,binary-body-mode=false,timeout=20,tag=美团我的页面
http-response ^https?:\/\/apimobile\.meituan\.com\/group\/v1\/deal\/searchpage\/defaultword script-path=https://raw.githubusercontent.com/zhangx16/loon/main/scripts/meituan/mt.js,requires-body=true,binary-body-mode=false,timeout=20,tag=美团搜索默认词
http-response ^https?:\/\/apimobile\.meituan\.com\/group\/v1\/deal\/searchpage\/hotword\/city\/divide\/hotrecommend\/ script-path=https://raw.githubusercontent.com/zhangx16/loon/main/scripts/meituan/mt.js,requires-body=true,binary-body-mode=false,timeout=20,tag=美团搜索推荐
http-response ^https?:\/\/assistify\.meituan\.com\/assistant\/getAppClientHornConfig script-path=https://raw.githubusercontent.com/zhangx16/loon/main/scripts/meituan/mt.js,requires-body=true,binary-body-mode=false,timeout=20,tag=美团AI技能
http-response ^https?:\/\/mop\.meituan\.com\/mop\/entry\/shoppingCartEntry script-path=https://raw.githubusercontent.com/zhangx16/loon/main/scripts/meituan/mt.js,requires-body=true,binary-body-mode=false,timeout=20,tag=美团购物车横幅
http-response ^https?:\/\/mop\.meituan\.com\/api\/entryModule\/startupPicture script-path=https://raw.githubusercontent.com/zhangx16/loon/main/scripts/meituan/mt.js,requires-body=true,binary-body-mode=false,timeout=20,tag=美团启动图

[Mitm]
hostname = apimobile.meituan.com, feedguess.meituan.com, mop.meituan.com, mt-personalcenter.meituan.com, assistify.meituan.com
