#!name = tencent-sports-zenmo-clean
#!desc = 腾讯体育净化（ZenmoFeiShi 版）：开屏、我的页、底部会员入口、首页展示及搜索热词。与 tencent-sports-clean 二选一。
#!author = TG@ZenMoFiShi, zhangx16（Loon 适配）
#!homepage = https://github.com/zhangx16/loon
#!loon_version = 3.5.1(983)
#!date = 2026-11-01
# 上游：ZenmoFeiShi/Qx，提交 0569e497ba42b342d8d52e87f096dbdac91bf803
# 二进制 bodyBytes 转为 Loon Uint8Array body；内置 Protobuf/JCE/gzip 逻辑保留。
# CDN 备用：https://cdn.jsdelivr.net/gh/zhangx16/loon@main/scripts/tencent-sports/zenmo-clean.js
# 禁用旧版 tencent-sports-clean，避免其空开屏响应和 feeds/list 脚本覆盖本版。
# sports.ssp 请求添加仅含 0/1 的 X-Loon-Sports-SSP-Target Header 供响应阶段识别。

[Script]
response if ${url} ~= /^https:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$/ && ${request.header['User-Agent']} ~= /^QQSportsV3\//i then script("https://raw.githubusercontent.com/zhangx16/loon/main/scripts/tencent-sports/zenmo-clean.js") with requires_body=true, binary_body_mode=true, timeout=20, tag="腾讯体育开屏配置"
http-response ^https:\/\/k\.ssp\.qq\.com\/getsdkconfig(?:\?.*)?$ script-path=https://raw.githubusercontent.com/zhangx16/loon/main/scripts/tencent-sports/zenmo-clean.js,requires-body=true,binary-body-mode=false,timeout=20,tag=腾讯体育净化
http-response ^https:\/\/app\.sports\.qq\.com\/init\/config(?:\?.*)?$ script-path=https://raw.githubusercontent.com/zhangx16/loon/main/scripts/tencent-sports/zenmo-clean.js,requires-body=true,binary-body-mode=false,timeout=20,tag=腾讯体育净化
http-response ^https:\/\/app\.sports\.qq\.com\/user\/homePageV2(?:\?.*)?$ script-path=https://raw.githubusercontent.com/zhangx16/loon/main/scripts/tencent-sports/zenmo-clean.js,requires-body=true,binary-body-mode=false,timeout=20,tag=腾讯体育净化
http-response ^https:\/\/app\.sports\.qq\.com\/m\/match\/liveSum(?:\?.*)?$ script-path=https://raw.githubusercontent.com/zhangx16/loon/main/scripts/tencent-sports/zenmo-clean.js,requires-body=true,binary-body-mode=false,timeout=20,tag=腾讯体育净化
http-response ^https:\/\/app\.sports\.qq\.com\/match\/multiUpdate(?:\?.*)?$ script-path=https://raw.githubusercontent.com/zhangx16/loon/main/scripts/tencent-sports/zenmo-clean.js,requires-body=true,binary-body-mode=false,timeout=20,tag=腾讯体育净化
http-response ^https:\/\/app\.sports\.qq\.com\/feeds\/(?:home|list)(?:\?.*)?$ script-path=https://raw.githubusercontent.com/zhangx16/loon/main/scripts/tencent-sports/zenmo-clean.js,requires-body=true,binary-body-mode=false,timeout=20,tag=腾讯体育净化
http-response ^https:\/\/sports\.ssp\.qq\.com\/app(?:\?.*)?$ script-path=https://raw.githubusercontent.com/zhangx16/loon/main/scripts/tencent-sports/zenmo-clean.js,requires-body=true,binary-body-mode=false,timeout=20,tag=腾讯体育净化
http-request ^https:\/\/sports\.ssp\.qq\.com\/app(?:\?.*)?$ script-path=https://raw.githubusercontent.com/zhangx16/loon/main/scripts/tencent-sports/zenmo-clean.js,requires-body=true,binary-body-mode=false,timeout=20,tag=腾讯体育广告请求识别

[Mitm]
hostname = config.ab.qq.com, k.ssp.qq.com, app.sports.qq.com, sports.ssp.qq.com
