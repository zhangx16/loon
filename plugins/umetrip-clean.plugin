#!name = umetrip-clean
#!desc = 航旅纵横净化（墨鱼版）：开屏、运营弹窗、首页推广、瀑布流和会员营销。按原 rpid 标识处理指定响应；需开启 MitM 并信任证书，效果待真机验证。
#!author = @ddgksf2013, zhangx16（Loon 适配）
#!homepage = https://github.com/zhangx16/loon
#!date = 2026-11-01
# 规则来源：https://ddgksf2013.top/rewrite/UmetripAds.conf（V1.0.3，2026-10-05）
# 脚本来源：https://ddgksf2013.top/scripts/umetrip.ads.js（V1.5.0，2026-11-01 获取）
# 上游脚本 SHA-256：f1a37c300126b1bd64451261207a9166ee2aad77a3e79705a0f5c24229aef46e
# 保留原业务标识和净化逻辑；QX bodyBytes 转为 Loon Uint8Array body。
# CDN 备用：https://cdn.jsdelivr.net/gh/zhangx16/loon@main/scripts/umetrip/ad-clean.js

[Rewrite]
^https:\/\/oss\.umetrip\.com\/fs\/advert\/ reject-img

[Script]
http-response ^https:\/\/(?:sns|appmsg|home|umehome|opactivity|activity|umerp|flightstatus|umeflightstatus|startup|umestartup|user|umeuser|event)\.umetrip\.com\/gateway\/api\/umetrip\/native(?:\?.*)?$ script-path=https://raw.githubusercontent.com/zhangx16/loon/main/scripts/umetrip/ad-clean.js,requires-body=true,binary-body-mode=true,timeout=20,tag=航旅纵横净化

[Mitm]
hostname = sns.umetrip.com, appmsg.umetrip.com, home.umetrip.com, umehome.umetrip.com, opactivity.umetrip.com, activity.umetrip.com, umerp.umetrip.com, flightstatus.umetrip.com, umeflightstatus.umetrip.com, startup.umetrip.com, umestartup.umetrip.com, user.umetrip.com, umeuser.umetrip.com, event.umetrip.com, oss.umetrip.com
