#!name = bilibili-pcdn-block
#!desc = B 站 PCDN 与埋点拦截，含用户提供的通用 PCDN/云厂商域名及关键词。无需 MitM；也可能影响猫耳 FM 和其他使用这些域名的服务。
#!author = zhangx16（整理适配；原规则作者未注明）
#!homepage = https://github.com/zhangx16/loon
#!date = 2026-11-08
# 来源：用户提供的域名列表，未独立验证各域名当前用途及覆盖效果。
# 统一补齐 REJECT；去重；edge.mountaintoys.cn 已由 mountaintoys.cn 覆盖。
# pcdn.biliapi.net 不含通配符，使用 DOMAIN 精确匹配，不要求 DOMAIN-WILDCARD 新版本。
# 如播放器等待重试或其他服务受影响，可单独停用此插件。

[Rule]
# Bilibili / 猫耳 FM（用户提供）
DOMAIN-SUFFIX,solseedr.cn,REJECT
DOMAIN-SUFFIX,solseed.cn,REJECT

# Pai Ou Cloud / 通用 PCDN（用户提供，作用不限于 B 站）
