#!name = hellobike-clean
#!desc = 哈啰净化：弹窗、首页推荐、借钱入口、会员领券横条和我的页推广。需开启 MitM；首次启用后重启哈啰，以捕获本机动态密钥。
#!author = TG@ZenMoFiShi, zhangx16
#!homepage = https://github.com/zhangx16/loon
#!date = 2026-10-25
# 上游：ZenmoFeiShi/Qx/helloobike.snippet（2026-10-23）及 easybike-ad.js（2026-10-25 获取）。
# 密钥仅保存在 Loon 本机；请求关联使用不含密钥的 X-Loon-HelloBike-Context Header。
# CDN 备用：https://cdn.jsdelivr.net/gh/zhangx16/loon@main/scripts/hellobike/easybike-ad.js

[Rewrite]
^https?:\/\/api-htp\.beizi\.biz\/mb\/sdk0\/json(?:\?|$) reject-200
^https?:\/\/adservice\.sigmob\.cn\/(?:hb\/v2\/ad|ad\/v4)(?:\?|$) reject-200
^https?:\/\/tm\.sigmob\.cn\/(?:waterfall\/v1|strategy\/v6)(?:\?|$) reject-200
^https?:\/\/(?:mi|v2mi)\.gdt\.qq\.com\/(?:gdt_mview\.fcg|server_bidding2)(?:\?|$) reject-200

[Script]
http-request ^https:\/\/resource\.51downapp\.cn\/f414fbc17c411b4e986ba8891c738a49\.json\?(?:[^#]*&)?md5=e5230c919f7e3f3af3256161fbfaa0e2&(?:[^#]*&)?hbe_qx_ui=1\.3$ script-path=https://raw.githubusercontent.com/zhangx16/loon/main/scripts/hellobike/easybike-ad.js,requires-body=false,binary-body-mode=false,timeout=20,tag=哈啰页面模板
http-response ^https:\/\/api\.hellobike\.com(?::443)?\/secretkey(?:\?|$) script-path=https://raw.githubusercontent.com/zhangx16/loon/main/scripts/hellobike/easybike-ad.js,requires-body=true,binary-body-mode=false,timeout=20,tag=哈啰动态密钥
http-request ^https?:\/\/(?:api|marketingapi|entertainment)\.hellobike\.com(?::\d+)?\/api(?:\?|$) script-path=https://raw.githubusercontent.com/zhangx16/loon/main/scripts/hellobike/easybike-ad.js,requires-body=true,binary-body-mode=false,timeout=20,tag=哈啰请求关联
http-response ^https?:\/\/(?:api|marketingapi|entertainment)\.hellobike\.com(?::\d+)?\/api(?:\?|$) script-path=https://raw.githubusercontent.com/zhangx16/loon/main/scripts/hellobike/easybike-ad.js,requires-body=true,binary-body-mode=false,timeout=20,tag=哈啰响应净化

[Mitm]
hostname = api.hellobike.com, marketingapi.hellobike.com, entertainment.hellobike.com, api-htp.beizi.biz, adservice.sigmob.cn, tm.sigmob.cn, mi.gdt.qq.com, v2mi.gdt.qq.com, resource.51downapp.cn
